# Tuya Cloud (iot.tuya.com -> проект -> Overview)
TUYA_REGION=eu
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=

# Telegram: токен от @BotFather, chat id у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Как часто писать показания в историю (сек)
POLL_INTERVAL=300
# Автоотчёт в чат (сек). 86400 = раз в сутки, 0 = выключен
REPORT_INTERVAL=0

# code:Название:масштаб:единица,...  Пусто = сначала нажмите «Все DP»
# Пример: cold_water:Холодная вода:0.001:м³,hot_water:Горячая вода:0.001:м³
SENSORS=

# --- Мониторинг и уведомления ---
# Нет новых показаний столько часов -> уведомление
NO_DATA_ALERT_HOURS=48
# Показания не меняются столько часов -> уведомление (0 = выключено; может срабатывать, если воду просто не тратят)
NO_CHANGE_ALERT_HOURS=0
# Устройство офлайн дольше N минут -> уведомление
OFFLINE_ALERT_MINUTES=30
# Tuya Cloud недоступен дольше N минут -> уведомление
API_FAIL_ALERT_MINUTES=30
# Напоминать о нерешённой проблеме раз в N часов
ALERT_REPEAT_HOURS=24
# Повтор опроса после ошибки (сек)
RETRY_INTERVAL=60
