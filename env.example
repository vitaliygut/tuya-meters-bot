# === Откуда брать показания счётчика ===
# cloud = через облачный Tuya API (нужны ключи облака, ~1 вызов API на чтение)
# local = по локальной сети (tinytuya), без облака и без лимита API; бот должен быть в одной сети с Neptun
# auto  = сначала локально, если не получилось, то через облако
READ_SOURCE=cloud

# --- Tuya Cloud (iot.tuya.com -> проект -> Overview). Для READ_SOURCE=local можно не заполнять,
#     если задан TUYA_LOCAL_KEY (но тогда не будет /diag и запасного облачного варианта) ---
TUYA_REGION=eu
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=

# --- Локальная сеть (для READ_SOURCE=local или auto). Проверка: команда /lan ---
# IP устройства (закрепите его за устройством в роутере)
TUYA_LOCAL_IP=
# local key. Пусто = бот один раз возьмёт его из облака (1 вызов API) и запомнит.
# Если в ключе есть символ $, берите значение в ОДИНАРНЫЕ кавычки: TUYA_LOCAL_KEY='abc$def'
TUYA_LOCAL_KEY=
# Версия протокола: auto, 3.3, 3.4, 3.5 (для вашего Neptun Smart подошла 3.4)
TUYA_LOCAL_VERSION=auto
# Сколько раз повторить локальный запрос при пустом ответе
LOCAL_RETRIES=3
# Лимит вызовов API в месяц (только для отображения в «Состояние»)
API_MONTHLY_LIMIT=26000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Чат, где работают кнопки (личный id или группа, например -5439348763)
TELEGRAM_CHAT_ID=
# Необязательно: куда слать отчёты и уведомления (канал/группа). Пусто = в TELEGRAM_CHAT_ID
NOTIFY_CHAT_ID=
# Часовой пояс контейнера, например Europe/Belgrade, Europe/Moscow
TZ=Europe/Belgrade

# --- Счётчики воды ---
# code:Название:масштаб:единица,... (значения Neptun в литрах, масштаб 0.001 даёт м³)
SENSORS=counter7:Горячая вода:0.001:м³,counter8:Холодная вода:0.001:м³

# Автосъём показаний раз в сутки (1 вызов API в день). Час по TZ, -1 = выключено
DAILY_READ_HOUR=8
# Если снятие не удалось, повторить через N минут
DAILY_RETRY_MINUTES=60
# true = присылать показания в чат каждый день (иначе просто сохраняются в базу)
DAILY_REPORT=false
# Нет показаний столько дней подряд -> тревога
NO_DATA_ALERT_DAYS=3
# Напоминать о нерешённой проблеме раз в N часов
ALERT_REPEAT_HOURS=24

# Ежемесячный отчёт в чат: число месяца (0 = выключен) и час (по TZ)
MONTHLY_REPORT_DAY=23
MONTHLY_REPORT_HOUR=9

# --- Передача показаний на mos.ru (Электронный дом) ---
# off = выключено, confirm = в назначенный день спросить кнопкой, auto = отправить сама
MOSRU_MODE=off
# День и час отправки (по TZ). По умолчанию берутся из MONTHLY_REPORT_DAY/HOUR, а если их нет, то 20-е
MOSRU_SUBMIT_DAY=20
MOSRU_SUBMIT_HOUR=9
# Какие DP Neptun какой воде соответствуют (должны быть в SENSORS)
MOSRU_COLD_CODE=counter8
MOSRU_HOT_CODE=counter7
# Если показание выросло относительно портала больше чем на N м³, отправка блокируется
MOSRU_MAX_DELTA=100
# Необязательно: задать вручную, если бот не определил сам (подсказки выдаст /mosru_login и /mosru_status)
# MOSRU_USER_PLACE_ID=
# MOSRU_COLD_ID=
# MOSRU_HOT_ID=
