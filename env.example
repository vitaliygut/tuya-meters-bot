TUYA_REGION=eu
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=
# Лимит вызовов API в месяц (только для отображения в «Состояние»)
API_MONTHLY_LIMIT=26000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Чат, где работают кнопки (личный id или группа, например -5439348763)
TELEGRAM_CHAT_ID=
# Необязательно: куда слать алерты и отчёты (канал/группа). Пусто = в TELEGRAM_CHAT_ID
NOTIFY_CHAT_ID=

# --- Счётчики (через облачный API) ---
# code:Название:масштаб:единица,...
SENSORS=counter7:Горячая вода:0.001:м³,counter8:Холодная вода:0.001:м³
# Автоматическое снятие показаний раз в сутки (1 вызов API в день). Час по TZ, -1 = выключено
DAILY_READ_HOUR=8
# Если снятие не удалось, повторить через N минут
DAILY_RETRY_MINUTES=60
# true = присылать показания в чат каждый день (иначе просто сохраняются в базу)
DAILY_REPORT=false
# Нет показаний столько дней подряд -> тревога
NO_DATA_ALERT_DAYS=3
# Ежемесячный отчёт: число месяца (0 = выключен) и час по времени TZ
MONTHLY_REPORT_DAY=23
MONTHLY_REPORT_HOUR=9
TZ=Europe/Belgrade

# --- Алерты (через локальную сеть, без лимитов API) ---
# IP устройства в локальной сети (лучше закрепить за ним адрес в роутере)
TUYA_LOCAL_IP=
# local key. Пусто = бот один раз возьмёт его из облака (1 вызов API) и запомнит.
# Если ключ содержит символ $, берите значение в ОДИНАРНЫЕ кавычки: TUYA_LOCAL_KEY='abc$def'
TUYA_LOCAL_KEY=
# Версия протокола: auto, 3.3, 3.4, 3.5
TUYA_LOCAL_VERSION=auto
# Как часто опрашивать устройство локально, сек
LOCAL_POLL_INTERVAL=15
# Нет связи с устройством дольше N минут -> тревога
OFFLINE_ALERT_MINUTES=10
# Напоминать о нерешённой проблеме связи раз в N часов
ALERT_REPEAT_HOURS=24

# Протечка и краны: code:Название:норма. Отличается от нормы -> тревога.
# LEAK_WATCH=status_wire_line:Проводные датчики:0,status_rf_sensor:Беспроводные датчики:null,notifications:Уведомления Neptun:0,status_crane_group_1:Кран группа 1:true,status_crane_group_2:Кран группа 2:true
# Повтор тревоги по протечке, пока не вернётся в норму (минуты)
LEAK_REPEAT_MINUTES=30
# --- Локальный Modbus Neptun Smart (протечка, краны, датчики, счётчики за секунды, без облака) ---
# Сначала проверьте командой /modbus. Включайте, только если она ответила.
MODBUS_ENABLED=false
# Адрес модуля (по умолчанию = TUYA_LOCAL_IP), порт и Modbus-адрес (заводской 240, см. DP address_modbus)
# MODBUS_HOST=
MODBUS_PORT=503
MODBUS_UNIT=240
MODBUS_POLL_INTERVAL=10
# auto | tcp | rtu
MODBUS_FRAMING=auto

# Контроль протечки/кранов через облако для DP, которых нет в локальном ответе (сек).
# 300 = ~8600 вызовов API в месяц. 0 = выключено (только если DP протечки приходят локально)
LEAK_CLOUD_INTERVAL=300

# --- Передача показаний на mos.ru (Электронный дом) ---
# off = выключено, confirm = в назначенный день спросить кнопкой, auto = отправить сама
MOSRU_MODE=off
# День и час отправки (по TZ). По умолчанию берутся из MONTHLY_REPORT_DAY/HOUR, а если их нет, то 20-е
MOSRU_SUBMIT_DAY=20
MOSRU_SUBMIT_HOUR=9
# Какие DP Neptun какой воде соответствуют (должны быть в SENSORS)
MOSRU_COLD_CODE=counter8
MOSRU_HOT_CODE=counter7
# Если показание выросло относительно портала больше чем на N м³, отправка блокируется
MOSRU_MAX_DELTA=100
# Необязательно: задать вручную, если бот не определил сам (подсказки выдаст /mosru_login и /mosru_status)
# MOSRU_USER_PLACE_ID=
# MOSRU_COLD_ID=
# MOSRU_HOT_ID=
